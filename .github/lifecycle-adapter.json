{
  "schema_version": 1,
  "name": "go",
  "runner": "ubuntu-latest",
  "toolchain": {
    "kind": "go",
    "version_file": "go.mod"
  },
  "required_files": [
    "go.mod"
  ],
  "check_commands": [
    [
      "go",
      "test",
